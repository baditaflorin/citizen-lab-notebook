{
  "name": "citizen-lab-notebook",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Browser lab notebook that captures experiments, analyzes data, and generates science-fair-ready reports.",
  "homepage": "https://baditaflorin.github.io/citizen-lab-notebook/",
  "repository": {
    "type": "git",
    "url": "https://github.com/baditaflorin/citizen-lab-notebook.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/prepare-pages.mjs",
    "build": "vite build && node scripts/finalize-pages.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "pages-preview": "bash scripts/pages-preview.sh",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "bash scripts/smoke.sh",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "perf:fixtures": "tsx scripts/measure-realdata.ts",
    "audit:security": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.5",
    "exifr": "^7.1.3",
    "idb": "^8.0.3",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.19",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  }
}
